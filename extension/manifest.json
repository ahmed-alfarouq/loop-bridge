{
  "manifest_version": 2,
  "name": "LoopBridge",
  "version": "0.2.0",
  "description": "Send selected chat text to the LoopBridge desktop app and fetch results back.",
  "browser_specific_settings": {
    "gecko": {
      "id": "loopbridge@example.org",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "menus",
    "nativeMessaging",
    "clipboardWrite"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "LoopBridge result",
    "default_popup": "popup.html"
  }
}
